{
  "title": "Gauge Chart Comprehensive Annotations - Edge Cases",
  "description": "Test data covering edge cases, different sizes, and comprehensive annotation scenarios",
  "testScenariosBase": [
    {
      "title": "Large gauge with many annotations",
      "width": 500,
      "height": 250,
      "chartValue": 50,
      "maxValue": 100,
      "minValue": 0,
      "segments": [
        { "legend": "Poor", "size": 25, "color": "error" },
        { "legend": "Fair", "size": 25, "color": "warning" },
        { "legend": "Good", "size": 25, "color": "success" },
        { "legend": "Excellent", "size": 25, "color": "success" }
      ],
      "annotations": [
        {
          "id": "title-label",
          "type": "text-label",
          "text": "System Performance",
          "position": "top",
          "fontSize": 16,
          "color": "currentColor"
        },
        {
          "id": "marker-0",
          "type": "threshold",
          "text": "0%",
          "position": "outer-arc",
          "value": 0,
          "fontSize": 11,
          "offset": [0, -5]
        },
        {
          "id": "marker-25",
          "type": "threshold",
          "text": "25%",
          "position": "outer-arc",
          "value": 25,
          "fontSize": 11,
          "offset": [0, 5]
        },
        {
          "id": "marker-50",
          "type": "threshold",
          "text": "50%",
          "position": "outer-arc",
          "value": 50,
          "fontSize": 11,
          "offset": [0, 5]
        },
        {
          "id": "marker-75",
          "type": "threshold",
          "text": "75%",
          "position": "outer-arc",
          "value": 75,
          "fontSize": 11,
          "offset": [0, 5]
        },
        {
          "id": "marker-100",
          "type": "threshold",
          "text": "100%",
          "position": "outer-arc",
          "value": 100,
          "fontSize": 11,
          "offset": [0, -5]
        },
        {
          "id": "current-value",
          "type": "value-marker",
          "text": "50%",
          "position": "above-needle",
          "fontSize": 15,
          "color": "currentColor"
        }
      ],
      "testCases": [
        {
          "value": 0,
          "label": "Minimum value"
        },
        {
          "value": 25,
          "label": "Poor performance"
        },
        {
          "value": 50,
          "label": "Mid range"
        },
        {
          "value": 75,
          "label": "Good performance"
        },
        {
          "value": 100,
          "label": "Excellent performance"
        }
      ]
    },
